[ -e debian/control ] \
  && cmp -s debian/control debian/control.tmp \
  && rm -f debian/control.tmp && exit 0; \
  mv debian/control.tmp debian/control
: # We have to prepare the various control files
for f in debian/*.in; do \
  f2=`echo $f | sed "s,PVER,python3.15,g;s/@VER@/3.15/g;s,\.in$,,"`; \
  if [ $f2 != debian/control ]; then \
    sed -e "s/@PVER@/python3.15/g;s/@VER@/3.15/g;s/@SVER@/3.15.0~rc1/g" \
	    -e "s/@PRIORITY@/3150/g" \
	    -e "s,@SCRIPTDIR@,/usr/lib/python3.15,g" \
	    -e "s,@INFO@,,g" \
	    -e "s,@HOST_QUAL@,:amd64,g" \
	  <$f >$f2; \
  fi; \
done
