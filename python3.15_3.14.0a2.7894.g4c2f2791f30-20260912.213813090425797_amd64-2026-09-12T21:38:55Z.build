: # fix /usr/local path in build-details_*.json
sed -i -e '/base_interpreter/s,/usr/local/,/usr/,' \
	debian/tmp/usr/lib/python3.15/build-details..x86_64-linux-gnu.json
find debian/tmp/usr/lib/python3.15 -name '*_failed*.so'
find debian/tmp/usr/lib/python3.15 -name '*_failed*.so' | xargs -r rm -f
for i in debian/tmp/usr/lib/python3.15/lib-dynload/*.so; do \
  case "$i" in *x86_64-linux-gnu*) continue; esac; \
  b=$(basename $i .cpython-315m.so); \
  d=${b}.cpython-315m-x86_64-linux-gnu.so; \
  mv $i debian/tmp/usr/lib/python3.15/lib-dynload/$d; \
done
mkdir -p debian/tmp/usr/lib/python3
mv debian/tmp/usr/lib/python3.15/site-packages \
	debian/tmp/usr/lib/python3/dist-packages
rm -f debian/tmp/usr/lib/python3/dist-packages/README*
: # remove files, which are not packaged
rm -rf debian/tmp/usr/lib/python3.15/ctypes/macholib
rm -f debian/tmp/usr/share/man/man1/python3.1
if [ -d debian/tmp/usr/lib/python3.15/ensurepip/_bundled ]; then \
  echo "don't ship the prebuilt ensurepip/_bundled wheels."; \
  rm -rf debian/tmp/usr/lib/python3.15/ensurepip/_bundled; \
fi
don't ship the prebuilt ensurepip/_bundled wheels.
: # cannot build it, zlib maintainer won't provide a mingw build
