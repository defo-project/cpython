: # Move the binary into python3.15-minimal.
dh_installdirs -ppython3.15-minimal \
	usr/bin \
	usr/share/man/man1 \
	usr/local/lib/python3.15/dist-packages
dh_movefiles -ppython3.15-minimal --sourcedir=debian/tmp \
	usr/bin/python3.15 \
	usr/share/man/man1/python3.15.1
dh_usrlocal -ppython3.15-minimal
rv=0; \
for i in _abc _ast _bisect _blake2 _collections _csv _datetime _elementtree _functools _hashlib _heapq _json _locale _md5 _opcode _operator _pickle _posixsubprocess _random _sha1 _sha2 _sha3 _socket _ssl _stat _stringio _struct _tracemalloc array atexit binascii cmath fcntl grp itertools math pyexpat select spwd syslog time unicodedata zlib; do \
  if [ -f debian/tmp/usr/lib/python3.15/lib-dynload/$i.so ]; then \
    echo >&2 "extension $i not mentioned in Setup.dist"; \
    rv=1; \
  fi; \
done; \
exit $rv;
: # Install sitecustomize.py
cp -p debian/sitecustomize.py debian/libpython3.15-minimal/etc/python3.15/
dh_link -plibpython3.15-minimal \
	/etc/python3.15/sitecustomize.py /usr/lib/python3.15/sitecustomize.py
: # Move the static library and the header files into python3.15-dev.
sed -i -e 's/-flto=auto//g' -e 's/-flto//g' -e 's/-fuse-linker-plugin//g' -e 's/-ffat-lto-objects//g' -e 's/-frandom-seed=1:3.14.0a2.7894.g4c2f2791f30-20260912.213813090425797//g' -e '/^OPT/s,-O3,-O2,' -e 's/-O3/-O2/g' -e 's/-fprofile-use *-fprofile-correction//g' -e "s/-specs=[^ '\"]*//g" -e "s/-fdebug-prefix-map=[^ '\"]*//g" -e "s/-ffile-prefix-map=[^ '\"]*//g" -e 's,^RUNSHARED *=.*,RUNSHARED=,' -e '/BLDLIBRARY/s/-L\. //' \
	debian/tmp/usr/bin/python3.15-config
cp debian/tmp/usr/bin/python3.15-config debian/tmp/usr/bin/x86_64-linux-gnu-python3.15-config
dh_installdirs -plibpython3.15-dev \
	usr/bin \
	usr/lib/python3.15 \
	usr/include \
	usr/share/man/man1
dh_movefiles -plibpython3.15-dev --sourcedir=debian/tmp \
	usr/bin/x86_64-linux-gnu-python3.15*-config \
	usr/lib/python3.15/config-3.15-x86_64-linux-gnu \
	usr/include \
	usr/lib/x86_64-linux-gnu/libpython3.15.{a,so} \
	usr/lib/x86_64-linux-gnu/pkgconfig/python-3.15*.pc
sed 's/@subdir@/python3.15/;s/@header@/pyconfig.h/' \
	debian/multiarch.h.in > debian/libpython3.15-dev/usr/include/python3.15/pyconfig.h
sed -i \
    -e '/^Cflags:/s,$, -I${includedir}/x86_64-linux-gnu/python3.15,' \
    -e '/^libdir=/d;s/-L\${libdir} *//' \
	debian/libpython3.15-dev/usr/lib/x86_64-linux-gnu/pkgconfig/python-3.15.pc
dh_link -plibpython3.15-dev \
    /usr/lib/python3.15/config-3.15-x86_64-linux-gnu/libpython3.15.a \
	/usr/lib/x86_64-linux-gnu/libpython3.15.a
cp -p /build/package/package/build-shared/libpython3.15-pic.a \
	debian/libpython3.15-dev/usr/lib/python3.15/config-3.15-x86_64-linux-gnu/
mkdir -p debian/libpython3.15-dev/usr/src/python3.15/{Grammar,Parser}
cp -p Grammar/python.gram debian/libpython3.15-dev/usr/src/python3.15/Grammar/.
cp -p Parser/Python.asdl debian/libpython3.15-dev/usr/src/python3.15/Parser/.
dh_installdirs -ppython3.15-dev \
	usr/share/doc/python3.15 \
	usr/share/man/man1 \
	usr/lib/python3.15 \
	usr/lib/python3.15/doc/html
cp -p Misc/HISTORY Misc/README.valgrind \
	debian/README.maintainers \
	debian/test_results /build/package/package/build-static/pybench.log \
    debian/python3.15-dev/usr/share/doc/python3.15/
dh_movefiles -ppython3.15-dev --sourcedir=debian/tmp \
	usr/bin/python3.15*-config
: # in libpython3.15-dev, prefix python-config with triplets
cp -p debian/python3-config.1 \
	debian/libpython3.15-dev/usr/share/man/man1/x86_64-linux-gnu-python3.15-config.1
ln -sf x86_64-linux-gnu-python3.15-config debian/python3.15-dev/usr/bin/python3.15-config
ln -sf x86_64-linux-gnu-python3.15-config.1.gz debian/python3.15-dev/usr/share/man/man1/python3.15-config.1.gz
: # Move the gdbm extension file into python3.15-gdbm.
dh_installdirs -ppython3.15-gdbm \
	usr/lib/python3.15 \
	usr/lib/python3.15/lib-dynload
dh_movefiles -ppython3.15-gdbm --sourcedir=debian/tmp \
	usr/lib/python3.15/lib-dynload/_gdbm*.so
: # Move the Tkinter extension files into python3.15-tk.
dh_installdirs -ppython3.15-tk \
	usr/lib/python3.15 \
	usr/lib/python3.15/lib-dynload
dh_movefiles -ppython3.15-tk --sourcedir=debian/tmp \
	usr/lib/python3.15/tkinter \
	usr/lib/python3.15/lib-dynload/_tkinter*.so
: # The test framework into libpython3.15-stdlib
dh_movefiles -plibpython3.15-stdlib --sourcedir=debian/tmp \
	usr/lib/python3.15/test/{libregrtest,support} \
	usr/lib/python3.15/test/typinganndata \
	usr/lib/python3.15/test/{regrtest,test_support,__init__,__main__}.py
: # The complete testsuite into libpython3.15-testsuite
dh_movefiles -plibpython3.15-testsuite --sourcedir=debian/tmp \
	usr/lib/python3.15/test
rm -f debian/libpython3.15-testsuite/usr/lib/python3.15/test/test_ctypes/test_macholib.py
: # fixed upstream ...
chmod -x debian/libpython3.15-testsuite/usr/lib/python3.15/test/{test_dbm_gnu,test_dbm_ndbm}.py
: # Move the demos and tools into python3.15-examples's doc directory
dh_installdirs -ppython3.15-examples \
	usr/share/doc/python3.15/examples
dh_movefiles -ppython3.15-examples --sourcedir=debian/tmp \
	usr/lib/python3.15/turtledemo
cp -rp Tools/* debian/python3.15-examples/usr/share/doc/python3.15/examples/
rm -rf debian/python3.15-examples/usr/share/doc/python3.15/examples/Tools/{buildbot,msi}
: # XXX: We don't need rgb.txt, we'll use our own:
rm -rf debian/python3.15-examples/usr/share/doc/python3.15/examples/Tools/pynche/X
: # IDLE
mv debian/tmp/usr/bin/idle3.15 debian/tmp/usr/bin/idle-python3.15
rm -f debian/tmp/usr/lib/python3.15/idlelib/idle.bat
dh_installdirs -pidle-python3.15 \
	usr/bin \
	usr/share/man/man1
dh_movefiles -pidle-python3.15 --sourcedir=debian/tmp \
	usr/bin/idle-python3.15 \
	usr/lib/python3.15/idlelib
cp -p debian/idle-python3.15.1 debian/idle-python3.15/usr/share/man/man1/
: # Move the docs into python3.15's /usr/share/doc/python3.15 directory,
: # all other packages only have a copyright file.
dh_installdocs -ppython3.15 \
	README.rst Misc/NEWS Misc/ACKS debian/README.venv
ln -sf NEWS.gz debian/python3.15/usr/share/doc/python3.15/changelog.gz
dh_installdocs --all \
	-Npython3.15 -Npython3.15-dev -Npython3.15-dbg -Nlibpython3.15 \
	debian/README.Debian
dh_installdocs: warning: Not using auto-detected python3.15 as main doc package for python3.15-doc: With -A/--all, this would cause file-conflicts.
: # IDLE has its own changelogs, docs...
dh_installchangelogs -pidle-python3.15 Lib/idlelib/ChangeLog
dh_installdocs -pidle-python3.15 Lib/idlelib/{NEWS2x,News3,README,TODO,extend}.txt
mkdir -p debian/idle-python3.15/usr/share/applications
cp -p debian/idle.desktop \
	debian/idle-python3.15/usr/share/applications/idle-python3.15.desktop
: # those packages have own README.Debian's
install -m 644 -p debian/README.python3.15 \
	debian/python3.15/usr/share/doc/python3.15/README.Debian
install -m 644 -p debian/README.idle-python3.15 \
	debian/idle-python3.15/usr/share/doc/idle-python3.15/README.Debian
mkdir -p debian/python3.15-tk/usr/share/doc/python3.15 debian/python3.15-tk/usr/share/doc/python3.15-tk
cp -p debian/README.Tk debian/python3.15-tk/usr/share/doc/python3.15/
ln -sf ../python3.15/README.Tk debian/python3.15-tk/usr/share/doc/python3.15-tk/README.Tk
: # pyvenv and ensurepip files into python3.15-venv
dh_installdirs -ppython3.15-venv \
	usr/lib/python3.15
dh_movefiles -ppython3.15-venv \
	usr/lib/python3.15/ensurepip
: # library files into libpython3.15-stdlib
dh_installdirs -plibpython3.15-stdlib \
	usr/lib
dh_movefiles -plibpython3.15-stdlib \
	usr/lib/python3.15
# Mark the interpreter as being PEP668 EXTERNALLY-MANAGED
install -m 644 debian/EXTERNALLY-MANAGED \
	debian/libpython3.15-stdlib/usr/lib/python3.15
: # The rest goes into python3.15
mkdir -p debian/tmp/usr/lib/python3/dist-packages
(cd debian/tmp && tar cf - .) | (cd debian/python3.15 && tar xpf -)
rm -f debian/python3.15/usr/bin/python
: # Replace all '#!' calls to python with /usr/bin/python3.15
: # and make them executable
for p in python3.15 python3.15-venv libpython3.15-stdlib python3.15-minimal python3.15-nopie libpython3.15-minimal libpython3.15 python3.15-examples python3.15-dev libpython3.15-dev libpython3.15-testsuite idle-python3.15 python3.15-doc python3.15-dbg libpython3.15-dbg python3.15-full python3.15-tk python3.15-gdbm; do \
[ -d debian/$p ] || continue; \
for i in `find debian/$p -type f ! -name '*.so'`; do \
  sed '1s,#!.*python[^ ]*\(.*\),#! /usr/bin/python3.15\1,' \
	$i > $i.temp; \
  if cmp --quiet $i $i.temp; then \
    rm -f $i.temp; \
  else \
    if [ ! -x $i ]; then \
      echo "fixed x file permissions: $i"; \
    fi; \
    mv -f $i.temp $i; \
    chmod 755 $i; \
    echo "fixed interpreter: $i"; \
  fi; \
done; \
done
